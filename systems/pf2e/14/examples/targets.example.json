{
  "version": 1,
  "targets": [
    {
      "id": "pf2e-14-demo",
      "label": "PF2e system integration examples",
      "expectedWorldId": "REPLACE_WITH_WORLD_ID",
      "expectedOrigin": "https://foundry.example.invalid",
      "writeEnabled": true,
      "pythonExecutable": "python3",
      "integrationTimeoutMs": 30000,
      "integrationsEnabled": true,
      "provider": {
        "kind": "composite",
        "core": {
          "kind": "socketio",
          "baseUrl": "https://foundry.example.invalid",
          "usernameEnv": "FOUNDRY_PF2E_USERNAME",
          "passwordEnv": "FOUNDRY_PF2E_PASSWORD"
        },
        "execution": {
          "kind": "rest-api",
          "relayUrl": "https://relay.example.invalid",
          "apiKeyEnv": "FOUNDRY_PF2E_RELAY_API_KEY",
          "clientId": "REPLACE_WITH_PAIRED_RUNTIME_CLIENT_ID"
        }
      }
    }
  ]
}
